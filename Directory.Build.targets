<Project>
  <Target Name="HuskyRestore"
          BeforeTargets="Restore"
          Condition="'$(HUSKY)' != '0'"
          Inputs="$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory).config\dotnet-tools.json;$(MSBuildThisFileDirectory).husky\**\*"
          Outputs="$(MSBuildThisFileDirectory)husky.restore.stamp">
    <Exec Command="dotnet tool restore"
          StandardOutputImportance="Low"
          StandardErrorImportance="High"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          Condition="!Exists('$(MSBuildThisFileDirectory)husky.restore.stamp')" />
    <Exec Command="dotnet husky install"
          StandardOutputImportance="Low"
          StandardErrorImportance="High"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          Condition="!Exists('$(MSBuildThisFileDirectory)husky.restore.stamp')" />
    <Touch Files="$(MSBuildThisFileDirectory)husky.restore.stamp"
           Condition="!Exists('$(MSBuildThisFileDirectory)husky.restore.stamp')" />
  </Target>
</Project>
