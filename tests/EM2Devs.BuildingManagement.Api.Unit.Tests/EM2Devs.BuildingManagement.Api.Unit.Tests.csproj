<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>../TestResults/coverage.cobertura.xml</CoverletOutput>
    <Threshold>80</Threshold>
    <ThresholdType>line,branch,method</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <ExcludeByFile>**/obj/**/*.generated.cs</ExcludeByFile>
    <Exclude>[*.Tests]*,[*.Unit.Tests]*,[EM2Devs.BuildingManagement.Application]EM2Devs.BuildingManagement.Application.Contracts.Authentication.*,[EM2Devs.BuildingManagement.Application]EM2Devs.BuildingManagement.Application.Contracts.Managers.*,[EM2Devs.BuildingManagement.Application]EM2Devs.BuildingManagement.Application.Contracts.Buildings.*,[EM2Devs.BuildingManagement.Application]EM2Devs.BuildingManagement.Application.Contracts.Residents.*,[EM2Devs.BuildingManagement.Application]EM2Devs.BuildingManagement.Application.Contracts.Announcements.*,[EM2Devs.BuildingManagement.Application]EM2Devs.BuildingManagement.Application.Contracts.Documents.*,[EM2Devs.BuildingManagement.Application]EM2Devs.BuildingManagement.Application.Contracts.Visits.*,[EM2Devs.BuildingManagement.Application]EM2Devs.BuildingManagement.Application.Contracts.Incidents.*,[EM2Devs.BuildingManagement.Application]EM2Devs.BuildingManagement.Application.Contracts.Common.ErrorResponse</Exclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EM2Devs.BuildingManagement.Api\EM2Devs.BuildingManagement.Api.csproj" />
  </ItemGroup>

</Project>