{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "commit-message-linter",
      "command": "sh",
      "args": [".husky/csx/commit-lint.sh", "${args}"],
      "group": "commit-msg",
      "windows": {
        "command": "sh",
        "args": [".husky/csx/commit-lint.sh", "${args}"]
      }
    },
    {
      "name": "branch-name-linter",
      "command": "sh",
      "args": [".husky/csx/branch-lint.sh"],
      "group": "pre-push",
      "windows": {
        "command": "sh",
        "args": [".husky/csx/branch-lint.sh"]
      }
    },
    {
      "name": "mutation-testing",
      "command": "sh",
      "args": [".husky/csx/mutation-test.sh"],
      "group": "pre-push",
      "windows": {
        "command": "sh",
        "args": [".husky/csx/mutation-test.sh"]
      }
    },
    {
      "name": "dotnet-format",
      "command": "dotnet",
      "args": ["format", "--verify-no-changes", "--verbosity", "quiet"],
      "group": "pre-commit",
      "include": ["**/*.cs"]
    },
    {
      "name": "dotnet-build",
      "command": "dotnet",
      "args": ["build", "-c", "Release", "--nologo", "-v", "q", "--no-restore"],
      "group": "pre-commit"
    },
    {
      "name": "dotnet-test",
      "command": "dotnet",
      "args": ["test", "-c", "Release", "--no-build", "--no-restore", "--nologo", "-v", "q"],
      "group": "pre-commit"
    }
  ]
}
